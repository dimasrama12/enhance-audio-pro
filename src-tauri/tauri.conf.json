{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enhance Audio Pro",
  "version": "0.1.0",
  "identifier": "com.enhanceaudiopro.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Enhance Audio Pro",
        "width": 1276,
        "height": 753,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/backend"],
    "resources": [
      "WebView2Loader.dll"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "hooks.nsh",
        "compression": "none"
      }
    }
  }
}
